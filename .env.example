# Required for the /narrate endpoint (AI step labels + phase summary).
# Get one at https://console.anthropic.com/
# The /trace endpoint works without this key.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Comma-separated list of frontend origins allowed to call the API.
# In development this defaults to http://localhost:5173 — override for production.
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=
